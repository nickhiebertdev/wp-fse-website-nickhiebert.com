# Ignore core WordPress configuration files with sensitive data
wp-config.php

# Ignore user-uploaded media files (keep these on the server only)
wp-content/uploads/
wp-content/blogs.dir/

# Ignore server-generated error logs and system logs
*.log
.hcflag
error_log

# Ignore development files and local environment configs
.DS_Store
.vscode/
sftp.json

# Ignore JS dependencies and environment secrets
node_modules/
.env
# Ignore stale SSL domain-validation tokens
.well-known/pki-validation/

# Ignore WordPress core (managed by WordPress updates, not this repo)
wp-admin/
wp-includes/
wp-login.php
wp-activate.php
wp-cron.php
wp-mail.php
wp-settings.php
wp-signup.php
wp-trackback.php
xmlrpc.php
wp-blog-header.php
wp-comments-post.php
wp-links-opml.php
wp-load.php

# Ignore backup files
.htaccess.bk
